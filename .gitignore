# =============================================
# TIFA Web (Next.js) .gitignore
# =============================================

# Dependencies
node_modules/
.pnpm-store/

# Next.js build output
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# Environment variables & local data
.env
.env*.local
.env.local
data/settings.json
data/*.json

# Logs & Debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & IDE Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.pem
