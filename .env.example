# TIFA Web Dashboard - Environment Variables
# 
# Copy this file to .env.local and fill in your actual values
# Command: cp .env.example .env.local
# 
# Created: May 7, 2026

# ==========================================
# Database Configuration
# ==========================================
# PostgreSQL connection string
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Examples:
#   postgresql://postgres:password@localhost:5432/tifa_db
#   postgresql://postgres:password@db.example.com:5432/tifa_prod
DATABASE_URL=postgresql://postgres:password@localhost:5432/tifa_db

# ==========================================
# WebSocket Configuration
# ==========================================
# WebSocket Gateway URL (used by browser/client)
# For development: ws://localhost:3001
# For production: wss://your-domain.com:3001 (with SSL)
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# ==========================================
# API Configuration
# ==========================================
# Backend API base URL (used by browser/client)
# For development: http://localhost:8080
# For production: https://api.your-domain.com
NEXT_PUBLIC_API_URL=http://localhost:8080

# ==========================================
# Node Environment
# ==========================================
# Set to one of: development, staging, production
NODE_ENV=production

# ==========================================
# Next.js Configuration
# ==========================================
# Port to run on (default: 3000)
# PORT=3000

# Enable debug logging
# DEBUG=*

# ==========================================
# Optional: Cloudflare Tunnel
# ==========================================
# If using Cloudflare Tunnel for database access
# CLOUDFLARE_TUNNEL_TOKEN=your_token_here

# ==========================================
# Optional: Analytics
# ==========================================
# Google Analytics ID (if enabled)
# NEXT_PUBLIC_GA_ID=G-XXXXXXX

# ==========================================
# Optional: Logging
# ==========================================
# Log level: debug, info, warn, error
# LOG_LEVEL=info

# ==========================================
# Optional: Rate Limiting
# ==========================================
# API rate limit (requests per minute)
# RATE_LIMIT=60

# ==========================================
# Security
# ==========================================
# CORS allowed origins (comma separated)
# CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# ==========================================
# Notes
# ==========================================
# - Do NOT commit .env.local to git
# - Keep passwords and tokens secure
# - Update these values for your environment
# - Restart the application after changes
# - For production, use strong, unique values
